# Copy this file to .env and replace placeholders with new keys.
# LLM_PROVIDER=backboard   # backboard | openai (auto-detected from keys if unset)
BACKBOARD_API_KEY=your-backboard-api-key-here
# BACKBOARD_LLM_PROVIDER=openai
# BACKBOARD_MODEL=gpt-4o-mini
# BACKBOARD_BASE_URL=https://app.backboard.io/api

# OpenAI or any OpenAI-compatible API:
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
